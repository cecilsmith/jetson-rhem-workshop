# NVIDIA Jetson Orin — RHEL Image Mode (bootc) image with the Flight Control agent.
#
# This is the LIVING image definition. It floats: unless FLIGHTCTL_VERSION is
# pinned, it installs whatever is current. Frozen, fully-pinned snapshots of
# past builds live in ./archive/ and are never edited.
#
# Two variants are produced from this one file, differing only in COMPOSE_PROVIDER:
#
#   podman build \
#     --secret id=rh_username,src=.secrets/rh_username \
#     --secret id=rh_password,src=.secrets/rh_password \
#     --build-arg COMPOSE_PROVIDER=docker-compose \
#     --build-arg FLIGHTCTL_VERSION=1.3.0 \
#     --build-arg USERNAME=redhat --build-arg USER_PASSWD=redhat \
#     --squash -t localhost/jetson-docker-compose:1.3.0-$(date -u +%F) \
#     -f images/Containerfile .
#
# RHEL 9.4 / JetPack 6.1 are hardcoded because that is the only combination
# NVIDIA publishes a Jetson RPM repository for. See BUILDING.md.

FROM registry.redhat.io/rhel9/rhel-bootc:9.4

# ---------------------------------------------------------------------------
# Build arguments
# ---------------------------------------------------------------------------

# Which compose implementation to install. This is the only axis that varies
# between the two published images.
ARG COMPOSE_PROVIDER=docker-compose

# Flight Control agent version, e.g. 1.3.0. Leave empty to take whatever is
# newest in the repository. CI always pins it so the image matches its tag.
ARG FLIGHTCTL_VERSION=

# The login account created on the device.
#
# These are PUBLIC on purpose: anyone flashing this image needs to be able to
# log in. Build args are the right mechanism precisely because their values are
# recorded in the image history. Change them before deploying a device anywhere
# that matters.
ARG USERNAME=redhat
ARG USER_PASSWD=redhat

# ---------------------------------------------------------------------------
# Red Hat subscription
# ---------------------------------------------------------------------------
#
# Credentials arrive as build SECRETS, never as build args: buildah records
# --build-arg values in the image history, so a build arg would ship the
# password inside the image and into any published tarball.
RUN --mount=type=secret,id=rh_username --mount=type=secret,id=rh_password \
    if [ ! -s /run/secrets/rh_username ] || [ ! -s /run/secrets/rh_password ] ; then \
        echo "Build secrets rh_username and rh_password are mandatory" && exit 1 ; \
    fi && \
    subscription-manager register \
        --username="$(cat /run/secrets/rh_username)" \
        --password="$(cat /run/secrets/rh_password)" \
        --auto-attach && \
    subscription-manager repos --enable=rhel-9-for-aarch64-baseos-rpms && \
    subscription-manager repos --enable=rhel-9-for-aarch64-appstream-rpms

# EPEL is needed early: podman-compose and lorax both come from it.
RUN dnf -y install https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm && \
    dnf -y clean all

# ---------------------------------------------------------------------------
# NVIDIA Jetson Orin support
# ---------------------------------------------------------------------------

RUN curl -s -L https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo | tee /etc/yum.repos.d/nvidia-container-toolkit.repo
RUN curl -s -L https://repo.download.nvidia.com/jetson/rhel-9.4/jp6.1/nvidia-l4t.repo | tee /etc/yum.repos.d/nvidia-l4t.repo

RUN dnf -y install nvidia-jetpack-kmod nvidia-jetpack-all nvidia-container-toolkit && \
    dnf -y clean all

# Prevent the kernel from being updated
RUN echo "exclude=kernel* kmod-kvdo" >> /etc/yum.conf

# Regenerate the CDI mappings for the Jetson Orin iGPU on each boot
RUN cat > /usr/lib/systemd/system/nvidia-cdi.service <<EOF
[Unit]
Description=Generate the nvidia cdi yaml file
Requires=multi-user.target
After=multi-user.target
[Service]
Type=oneshot
ExecStart=nvidia-ctk cdi generate --output=/etc/cdi/nvidia
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
EOF
RUN systemctl enable nvidia-cdi.service

# ---------------------------------------------------------------------------
# Device user
# ---------------------------------------------------------------------------

RUN if [ -z "${USERNAME}" ] || [ -z "${USER_PASSWD}" ] ; then \
        echo "USERNAME and USER_PASSWD are mandatory build arguments" && exit 1 ; \
    fi && \
    useradd -m -d "/var/home/${USERNAME}" -G wheel "${USERNAME}" && \
    echo "${USERNAME}:${USER_PASSWD}" | chpasswd && \
    usermod -a -G video "${USERNAME}"

RUN dnf -y install firewalld && \
    dnf -y clean all && \
    firewall-offline-cmd --zone=public --add-port=22/tcp && \
    firewall-offline-cmd --zone=trusted --add-source=10.42.0.0/16

# ---------------------------------------------------------------------------
# Compose provider — the one thing that differs between the published images
# ---------------------------------------------------------------------------
#
# Neither branch installs a Docker daemon. docker-compose-plugin is just the
# Compose v2 binary, which `podman compose` drives as an external provider.
RUN case "${COMPOSE_PROVIDER}" in \
      docker-compose) \
          dnf config-manager --add-repo https://download.docker.com/linux/rhel/docker-ce.repo && \
          dnf -y install docker-compose-plugin ;; \
      podman-compose) \
          dnf -y install podman-compose ;; \
      *) \
          echo "COMPOSE_PROVIDER must be 'docker-compose' or 'podman-compose', got '${COMPOSE_PROVIDER}'" && \
          exit 1 ;; \
    esac && \
    dnf -y clean all

# ---------------------------------------------------------------------------
# Flight Control agent
# ---------------------------------------------------------------------------

RUN dnf config-manager --add-repo https://rpm.flightctl.io/flightctl-epel.repo && \
    if [ -n "${FLIGHTCTL_VERSION}" ] ; then \
        dnf -y install "flightctl-agent-${FLIGHTCTL_VERSION}" ; \
    else \
        dnf -y install flightctl-agent ; \
    fi && \
    dnf -y install lorax && \
    dnf -y clean all && \
    systemctl enable flightctl-agent.service

# Record what this image actually contains, so `podman inspect` answers the
# question without booting a device.
LABEL org.opencontainers.image.source="https://github.com/cecilsmith/jetson-bootc-flightctl" \
      org.opencontainers.image.description="NVIDIA Jetson Orin RHEL bootc image with the Flight Control agent" \
      io.flightctl.agent.version="${FLIGHTCTL_VERSION}" \
      io.jetson.compose-provider="${COMPOSE_PROVIDER}" \
      io.jetson.rhel-version="9.4" \
      io.jetson.jetpack-version="6.1"

RUN subscription-manager unregister && \
    subscription-manager clean

# Clean up all logs and caches
RUN rm /var/{log,cache,lib}/* -rf
